[internationalization]

locale/translations=PackedStringArray("res://Resources/Data/en.po", "res://Resources/Data/zh.po")
locale/fallback="zh"
locale/locale_filter_mode=1
locale/filter_locales=PackedStringArray("zh", "en")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
